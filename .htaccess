# NewsPlatform CMS - Root Apache Security & Routing Configuration

AddDefaultCharset UTF-8

# Protect Sensitive Directories & Files from Direct Web Access
<FilesMatch "^\.(git|env)|(schema\.sql|Dockerfile|render\.yaml|composer\.json)$">
    Require all denied
</FilesMatch>

# Prevent directory listings
Options -Indexes +FollowSymLinks

# PWA Headers & MIME Configurations
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
    <FilesMatch "(manifest\.json|\.webmanifest)$">
        Header set Content-Type "application/manifest+json; charset=utf-8"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .json .webmanifest
</IfModule>

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # PWA Dynamic Manifest Handler
    RewriteRule ^manifest\.json$ manifest.php [L,QSA]

    # Asset Fallback Routing (Maps /assets/... to /public/assets/...)
    RewriteRule ^assets/(.*)$ public/assets/$1 [L,QSA]

    # Clean REST API Routing
    RewriteRule ^api/v1/articles/?$ public/api/v1/articles.php [L,QSA]
    RewriteRule ^api/v1/categories/?$ public/api/v1/categories.php [L,QSA]
    RewriteRule ^api/v1/comments/?$ public/api/v1/comments.php [L,QSA]
    RewriteRule ^api/v1/subscription/?$ public/api/v1/subscription.php [L,QSA]
    RewriteRule ^api/v1/push-subscription/?$ public/api/v1/push-subscription.php [L,QSA]

    # Prevent direct browsing of protected internal folders
    RewriteRule ^(config|src|templates|languages)/(.*)$ - [F,L]
</IfModule>
